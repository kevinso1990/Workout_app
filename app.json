{
  "expo": {
    "name": "TrackYourLift",
    "slug": "fitplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitplan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ks15.trackyourlift",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "So you can photograph a workout plan and import it.",
        "NSPhotoLibraryUsageDescription": "So you can import a workout plan from your photos, or give an exercise your own picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F7",
        "foregroundImage": "./assets/images/android-icon-monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fitplan.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/facicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F7",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "So you can import a workout plan from your photos, or give an exercise your own picture.",
          "cameraPermission": "So you can photograph a workout plan and import it."
        }
      ],
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": false
        }
      ],
      "expo-video",
      "expo-dev-client",
      "./plugins/withPrivacyManifest.js",
      "expo-localization",
      "@sentry/react-native"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "f2fe52cd-fa6a-4cb1-89b5-da49ecaf31cf"
      }
    },
    "owner": "ks15",
    "locales": {
      "de": "./ios-locales/de.json",
      "en": "./ios-locales/en.json"
    }
  }
}
