# ── Local API (required on physical device) ───────────────────────────────────
# Your PC's Wi-Fi IPv4 + Express port. Find IP: ipconfig (Windows) / ifconfig (Mac).
# EXPO_PUBLIC_API_URL=http://192.168.178.102:5000
#
# Metro LAN IP (must match your PC Wi-Fi IPv4 — ipconfig on Windows):
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.178.102
#
# Start backend:  npm run server:dev
# Start Expo:     npm start          (LAN on port 8081, not --tunnel)
# iOS: use Expo Go → Projects → Scan QR (not the Camera app)
# iOS: Settings → Expo Go → Local Network → ON
# Do NOT use eas build / Replit / Expo tunnel for API traffic.

# ── Subscriptions (RevenueCat — enable for store builds) ─────────────────────
# EXPO_PUBLIC_SUBSCRIPTIONS_ENABLED=true
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
#
# Server (deployed backend):
# SUBSCRIPTIONS_ENABLED=true
# REVENUECAT_WEBHOOK_SECRET=your_webhook_bearer_secret

# ── Exercise media provider ───────────────────────────────────────────────────
# EXPO_PUBLIC_MEDIA_PROVIDER=static

# ── RapidAPI ExerciseDB (animated GIFs in workout) ────────────────────────────
# Client (Expo EAS Secret — baked at build time):
# EXPO_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key_here
# Vite web deploy:
# VITE_RAPIDAPI_KEY=your_rapidapi_key_here
# Server prefetch (Render/Railway env — optional, same key):
# RAPIDAPI_KEY=your_rapidapi_key_here

# ── Production API (EAS / TestFlight — point at deployed backend) ─────────────
# EXPO_PUBLIC_API_URL=https://your-api.onrender.com
#
# EAS Secrets (eas secret:create — required for Preview/Production builds):
#   EXPO_PUBLIC_API_URL                  → deployed Express HTTPS URL (import + sync)
#   EXPO_PUBLIC_RAPIDAPI_KEY             → ExerciseDB GIFs in app
#   EXPO_PUBLIC_SUBSCRIPTIONS_ENABLED    → "true" when RevenueCat is configured
#   EXPO_PUBLIC_REVENUECAT_IOS_API_KEY
#   EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY
#   EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID
#
# See EAS_BUILD.md for the full pre-build checklist.
#
# Server env (Render/Railway — required for import + plans API):
#   JWT_SECRET, GEMINI_API_KEY and/or ANTHROPIC_API_KEY, RAPIDAPI_KEY (optional)
#   SUBSCRIPTIONS_ENABLED, REVENUECAT_WEBHOOK_SECRET (when IAP is live)

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=5000
# NODE_ENV=development
# GEMINI_API_KEY=your_gemini_key
# JWT_SECRET=change_me_in_production
# DB_PATH=./data/app.db
