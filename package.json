{
  "name": "my-app",
  "main": "client/index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/start-expo-cloudflare.mjs",
    "start:ngrok-tunnel": "node scripts/start-expo-tunnel.mjs",
    "start:lan": "node scripts/start-expo-go.mjs",
    "kill:metro": "node scripts/kill-metro.mjs",
    "start:clear": "node scripts/start-expo-go.mjs --clear",
    "metro:firewall": "powershell -ExecutionPolicy Bypass -File scripts/allow-metro-firewall.ps1",
    "start:dev-client": "node scripts/start-expo-go.mjs",
    "start:localhost": "npx expo start --localhost --go",
    "android": "node scripts/start-expo-go.mjs --android",
    "ios": "node scripts/start-expo-go.mjs --ios",
    "web": "npx expo start --web --localhost",
    "server:dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "server:rebuild-db": "npm rebuild better-sqlite3",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:build:deploy": "npm run build --prefix server",
    "server:start:dist": "cross-env NODE_ENV=production node server/dist/index.js",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "load:baseline": "artillery run load-tests/baseline.yml",
    "load:plan-generate": "artillery run load-tests/plan-generate.yml",
    "load:workout": "artillery run load-tests/workout-flow.yml",
    "load:spike": "artillery run load-tests/spike.yml",
    "test:component": "node ./node_modules/vitest/vitest.mjs run --config vitest.component.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@google/generative-ai": "^0.24.1",
